rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roleName) {
      return isAuthenticated() && (
        ('roles' in getUserData() && roleName in getUserData().roles) ||
        ('role' in getUserData() && getUserData().role == roleName)
      );
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if hasRole('BUSINESS') && request.resource.data.businessId == request.auth.uid;
      allow update, delete: if hasRole('BUSINESS') && resource.data.businessId == request.auth.uid;
    }

    match /live_orders/{orderId} {
      allow read: if isAuthenticated();

      allow create: if hasRole('CLIENT')
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.status == 'PENDING_ACCEPTANCE';

      allow update: if isAuthenticated() && (
        (resource.data.clientId == request.auth.uid
         && request.resource.data.status == 'CANCELLED'
         && resource.data.status == 'PENDING_ACCEPTANCE')

        ||

        (
          hasRole('COURIER')
          && request.auth.uid != resource.data.clientId
          && (!('businessId' in resource.data) || request.auth.uid != resource.data.businessId)
          && (
            (
              resource.data.assignedCourierId == null
              && request.resource.data.assignedCourierId == request.auth.uid
              && request.resource.data.status == 'COURIER_ASSIGNED'
            )
            ||
            (
              resource.data.assignedCourierId == request.auth.uid
              && request.resource.data.status in ['PICKED_UP_AT_BIKE', 'IN_TRANSIT_TO_CLIENT', 'DELIVERED']
              && request.resource.data.cart == resource.data.cart
              && request.resource.data.deliveryPin == resource.data.deliveryPin
            )
          )
        )

        ||

        (hasRole('BUSINESS')
         && request.resource.data.status in ['PREPARING_AT_BUSINESS', 'READY_FOR_PICKUP', 'CANCELLED'])
      );

      allow delete: if false;
    }
  }
}
